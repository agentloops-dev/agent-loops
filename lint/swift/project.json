{
  "name": "swift-lint",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "lint/swift",
  "tags": ["xcode"],
  "implicitDependencies": ["*", "!repo-lint"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/lint.sh swift periphery",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "{workspaceRoot}/**/*.swift",
        "!{workspaceRoot}/**/.build/**/*",
        "!{workspaceRoot}/build/**/*",
        "!{workspaceRoot}/.agents/worktrees/**/*",
        "{workspaceRoot}/.swiftlint.yml",
        "{workspaceRoot}/.swiftlint-baseline.json",
        "{workspaceRoot}/.periphery-allowed.txt",
        "{workspaceRoot}/project.yml",
        "{workspaceRoot}/Packages/*/Package.swift",
        "{workspaceRoot}/Packages/*/Package.resolved",
        "{workspaceRoot}/.xcode-version",
        "{workspaceRoot}/scripts/lint.sh",
        "{workspaceRoot}/scripts/periphery-report.py",
        "{workspaceRoot}/scripts/build-cache.sh",
        "{projectRoot}/project.json"
      ]
    }
  }
}
