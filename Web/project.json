{
  "name": "web",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "root": "Web",
  "namedInputs": {
    "web-source": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "!{projectRoot}/coverage/**/*",
      "!{projectRoot}/node_modules/**/*",
      "node-toolchain",
      "generator-sources"
    ],
    "web-test-reads": [
      "{workspaceRoot}/App/Sources/Chat/ChatView.swift",
      "{workspaceRoot}/App/Sources/Chat/PromptBar.swift",
      "{workspaceRoot}/App/Sources/Sidebar/AgentBrowserPane.swift",
      "{workspaceRoot}/App/Sources/Sidebar/SidebarState.swift",
      "{workspaceRoot}/Go/internal/agentsd/changes.go",
      "{workspaceRoot}/Packages/AgentsKit/Sources/AgentsKitCore/Model/BrowserSettings.swift",
      "{workspaceRoot}/Packages/AgentsKit/Sources/AgentsKitCore/Model/DailyChecksSettings.swift",
      "{workspaceRoot}/Packages/AgentsKit/Sources/AgentsKitCore/Model/Maturity.swift",
      "{workspaceRoot}/Packages/AgentsKit/Sources/AgentsKitCore/Model/SessionPrompts.swift",
      "{workspaceRoot}/Packages/AgentsKit/Tests/AgentsKitTests/Fixtures/**/*",
      "{workspaceRoot}/Remote/Sources/Chat/PromptBar.swift",
      "{workspaceRoot}/Remote/Sources/Chat/RemoteChatView.swift",
      "{workspaceRoot}/Shared/UI/Chat/ChatTranscript.swift",
      "{workspaceRoot}/Shared/UI/Chat/DesktopControlPauseCard.swift",
      "{workspaceRoot}/Shared/UI/Chat/LiveTile.swift",
      "{workspaceRoot}/Shared/UI/Chat/NowCard.swift",
      "{workspaceRoot}/Shared/UI/Chat/TranscriptRows.swift",
      "{workspaceRoot}/Shared/UI/DailyChecksControls.swift",
      "{workspaceRoot}/Shared/UI/EarlyFeaturesSection.swift",
      "{workspaceRoot}/design/icons.json",
      "{workspaceRoot}/scripts/perf-budgets.json"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node build.mjs", "cwd": "{projectRoot}" },
      "inputs": ["sharedGlobals", "web-source"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["wire:gen", "design:gen"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["./node_modules/.bin/tsc --noEmit -p .", "node test/lint.mjs", "node test/licences.mjs", "../scripts/lint.sh web knip"],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "inputs": ["sharedGlobals", "web-source", "{workspaceRoot}/scripts/lint.sh"],
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test --test-timeout=60000 --test-force-exit test/*.test.mjs", "cwd": "{projectRoot}" },
      "inputs": ["sharedGlobals", "web-source", "web-test-reads"],
      "dependsOn": ["build"]
    }
  }
}
