# Generated from project.yml by xcodegen. Never edit or commit it.
Agents.xcodeproj/

# Agents' worktrees: the app's in .agents/worktrees, Claude Code's own in
# .claude/worktrees. Never committed.
.agents/worktrees/
.claude/worktrees/

# Built by scripts/build-linux-agentsd.sh (037). Build outputs. The
# README is kept so a fresh clone has the folder the app build copies.
App/Resources/servers/*
!App/Resources/servers/README.md

# Built by scripts/docs.sh (044). The docs site; published from CI, never committed.
/site/
.cache/

# The web remote's packages and its build (071, #473): Web/dist is built by
# scripts/web.sh dist, which Agents Host's build runs first, never committed.
Web/node_modules/
Web/dist/

# Go builds for walks and the Go host (#1136).
Go/out/
